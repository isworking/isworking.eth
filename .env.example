# Copy to .env.local for local development. In production, set these in Vercel.
# The full walkthrough (where each value comes from) is in docs/SETUP.md.
# There is no database: all state lives in the IsWorkingRegistrar contract.

# ─── Public (shipped to the browser) ───────────────────────────────────────
# Reown (WalletConnect) project ID: https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

NEXT_PUBLIC_SITE_URL=https://get.isworking.dev

# The registrar contract, shown in /admin → Setup after you deploy it.
NEXT_PUBLIC_REGISTRAR_ADDRESS=

# Public repository URL, linked from the FAQ and footer ("Open source").
NEXT_PUBLIC_SOURCE_URL=

# Optional RPC for the browser (wallet reads, receipts, admin history).
# Use a domain-restricted key; it's visible to everyone.
# NEXT_PUBLIC_RPC_URL_1=

# ─── Server secrets ────────────────────────────────────────────────────────
# The relayer: signs discount vouchers and pays gas for sponsored claims.
# A fresh wallet used only for this (`cast wallet new`), with ~0.01 ETH on Ethereum.
RELAYER_PRIVATE_KEY=

# Ethereum RPC for the server (Alchemy or Infura). Strongly recommended.
RPC_URL_1=
